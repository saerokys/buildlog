# BuildLog 백엔드 설정 예시
# 이 파일을 복사해 같은 폴더(backend)에 .env 파일을 만들고 값을 채웁니다.
# .env 파일은 Git에 기록되지 않습니다. 이 파일에는 실제 비밀값을 적지 않습니다.

# ---------------------------------------------------------------------
# DATABASE_URL (필수): Supabase 데이터베이스 연결 주소
# ---------------------------------------------------------------------
# 1. Supabase 대시보드에서 프로젝트를 열고 위쪽의 [Connect]를 누릅니다.
# 2. 연결 방식에서 "Session pooler"를 고르고 URI를 복사합니다.
#    모양: postgresql://postgres.<프로젝트ID>:[YOUR-PASSWORD]@aws-0-<지역>.pooler.supabase.com:5432/postgres
# 3. [YOUR-PASSWORD] 부분을 대괄호까지 지우고 데이터베이스 비밀번호를 넣습니다.
#    비밀번호에 @ : / # ? % 같은 특수문자가 있으면 URL 인코딩해서 넣습니다. (예: @ -> %40)
# 4. 등호(=) 뒤에 따옴표 없이 한 줄로 붙여 넣습니다.
# 비워두면 서버가 시작되지 않습니다. (SQLite로 자동 연결하지 않습니다.)
DATABASE_URL=

# ---------------------------------------------------------------------
# SECRET_KEY (필수): 로그인 토큰 서명용 비밀값
# ---------------------------------------------------------------------
# 만드는 방법: backend 폴더에서 아래 명령을 실행하고 나온 값을 붙여 넣습니다.
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 로그인 유지 시간(분), 기본값 1440분 = 1일
ACCESS_TOKEN_EXPIRE_MINUTES=1440
