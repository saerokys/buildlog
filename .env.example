# 이 파일을 복사해 같은 폴더에 .env 파일을 만들고 값을 채웁니다.
# .env 파일은 Git에 기록되지 않습니다. 이 파일에는 실제 비밀값을 적지 않습니다.

# 데이터베이스 연결 주소
# 비워두면 개발용 SQLite 파일(database/buildlog.sqlite3)을 사용합니다.
DATABASE_URL=

# 로그인 토큰 서명용 비밀값 (필수)
# 만드는 방법: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 로그인 유지 시간(분), 기본값 1440분 = 1일
ACCESS_TOKEN_EXPIRE_MINUTES=1440
